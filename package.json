{
  "name": "morag-ui-claude",
  "version": "1.0.0",
  "private": true,
  "description": "MoRAG UI - Modular Retrieval-Augmented Generation Platform",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run storybook\"",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:storybook": "storybook build",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:a11y": "jest --testNamePattern=\"Accessibility\"",
    "test:a11y:watch": "jest --testNamePattern=\"Accessibility\" --watch",
    "test:a11y:coverage": "jest --testNamePattern=\"Accessibility\" --coverage",
    "test:security": "jest --testNamePattern=\"Security\"",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:a11y": "eslint --ext .tsx,.ts components/ lib/ app/ --config .eslintrc.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "npm audit --audit-level=high && node scripts/validate-security.js",
    "security:test": "npm run test:security",
    "security:full": "npm run security:check && npm run test:security",
    "accessibility:check": "npm run lint:a11y && npm run test:a11y",
    "accessibility:full": "npm run lint:a11y && npm run test:a11y:coverage && npm run storybook:build"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/jest-axe": "^3.5.9",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react-window": "^1.8.8",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.6",
    "file-type": "^21.0.0",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.542.0",
    "next": "^15.5.2",
    "next-themes": "^0.4.6",
    "playwright": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^2.1.0",
    "recharts": "^3.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "nextjs",
    "typescript",
    "tailwindcss",
    "morag",
    "rag",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@next/bundle-analyzer": "^15.5.2",
    "@storybook/addon-a11y": "^9.1.4",
    "@storybook/addon-coverage": "^2.0.0",
    "@storybook/addon-docs": "^9.1.4",
    "@storybook/nextjs": "^9.1.4",
    "@storybook/test-runner": "^0.23.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "@types/webpack": "^5.28.5",
    "axe-core": "^4.10.3",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jest": "^30.1.3",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.1.2",
    "path-browserify": "^1.0.1",
    "postcss-loader": "^8.2.0",
    "storybook": "^9.1.4",
    "stream-browserify": "^3.0.0",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.2",
    "util": "^0.12.5",
    "uuid": "^13.0.0",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
