# Environment Configuration Example
# Copy this file to .env.local and fill in your actual values

# Database Configuration
DATABASE_URL="mysql://user:password@localhost:3306/morag_dev"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# CSRF Protection
CSRF_SECRET="your-csrf-secret-key-different-from-jwt"

# API Keys for LLM Services
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_API_KEY="your-google-gemini-api-key"

# Vector Database Configuration (Optional)
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="your-pinecone-environment"

# Graph Database Configuration (Optional)  
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# External Services (Optional)
APIFY_API_TOKEN="your-apify-token-for-youtube-processing"

# Security Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiting (Optional - for production)
REDIS_URL="redis://localhost:6379"

# File Upload Configuration
MAX_FILE_SIZE="52428800"  # 50MB in bytes
MAX_FILES_COUNT="10"

# Email Configuration (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
FROM_EMAIL="noreply@yourapp.com"

# Monitoring and Logging (Optional)
SENTRY_DSN="your-sentry-dsn"
LOG_LEVEL="info"

# Feature Flags (Optional)
ENABLE_ANALYTICS="false"
ENABLE_LOGGING="true"
ENABLE_RATE_LIMITING="true"