{
  "extends": [
    "next/core-web-vitals",
    "plugin:jsx-a11y/recommended"
  ],
  "plugins": [
    "jsx-a11y"
  ],
  "rules": {
    // Accessibility rules from jsx-a11y plugin
    "jsx-a11y/accessible-emoji": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "warn",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-onchange": "warn",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",

    // Custom accessibility rules for the project
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/prefer-tag-over-role": "warn",
    
    // Enhanced form accessibility
    "jsx-a11y/label-has-for": ["error", {
      "required": {
        "some": ["nesting", "id"]
      }
    }],
    
    // Button and link accessibility
    "jsx-a11y/anchor-ambiguous-text": "warn"
  },
  "overrides": [
    {
      // Test files can have more lenient accessibility rules
      "files": [
        "**/__tests__/**/*",
        "**/*.test.*",
        "**/*.spec.*"
      ],
      "rules": {
        "jsx-a11y/no-autofocus": "off",
        "jsx-a11y/media-has-caption": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      // UI components that legitimately use ARIA roles for accessibility
      "files": [
        "components/ui/Skeleton.tsx", 
        "components/ui/Spinner.tsx",
        "components/ui/Button.tsx",
        "components/auth/RegisterForm.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-onchange": "off"
      }
    },
    {
      // Storybook files can have relaxed rules for demonstration purposes
      "files": ["**/*.stories.*"],
      "rules": {
        "@typescript-eslint/no-unused-vars": "off",
        "jsx-a11y/anchor-ambiguous-text": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/label-has-for": "off",
        "jsx-a11y/anchor-is-valid": "off",
        "jsx-a11y/no-redundant-roles": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-onchange": "off",
        "react/no-unescaped-entities": "off",
        "react-hooks/rules-of-hooks": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": "asChild",
      "components": {
        // Map custom components to their semantic roles for better linting
        "Button": "button",
        "Link": "a",
        "Input": "input",
        "Textarea": "textarea",
        "Select": "select",
        "Checkbox": "input",
        "RadioGroup": "radiogroup",
        "Switch": "switch",
        "Slider": "slider",
        "Dialog": "dialog",
        "AlertDialog": "alertdialog",
        "Sheet": "dialog",
        "Popover": "dialog",
        "Tooltip": "tooltip",
        "DropdownMenu": "menu",
        "NavigationMenu": "navigation",
        "Tabs": "tablist",
        "TabsList": "tablist",
        "TabsTrigger": "tab",
        "TabsContent": "tabpanel",
        "Accordion": "region",
        "AccordionTrigger": "button",
        "AccordionContent": "region",
        "Card": "article",
        "Badge": "status",
        "Progress": "progressbar",
        "Separator": "separator",
        "ScrollArea": "region",
        "Table": "table",
        "TableHeader": "rowgroup",
        "TableBody": "rowgroup",
        "TableRow": "row",
        "TableCell": "cell",
        "TableHead": "columnheader"
      }
    }
  }
}